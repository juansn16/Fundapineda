# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=funda_pineda_db
DB_PORT=3306

# JWT
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA subir el valor real a git. Rotar la clave invalida todos los tokens.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# URL publica del frontend (para los enlaces de restablecimiento de contrasena)
FRONTEND_URL=https://fundapineda.org

# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo saliente (verificacion de cuenta y restablecimiento de contrasena)
# En Gmail se necesita una "contrasena de aplicacion", no la contrasena de la cuenta.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=FundaPineda
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

CONTACT_NOTIFICATION_EMAIL=

# Proxies de confianza para resolver la IP real del cliente.
# Vacio = usar siempre la IP directa de la conexion (correcto en local).
# Detras de nginx (produccion): TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=
