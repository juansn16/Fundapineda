# FundaPineda - backend (uvicorn) como servicio systemd
# Instalacion: copiar a /etc/systemd/system/fundapineda-backend.service y luego:
#   systemctl daemon-reload
#   systemctl enable --now fundapineda-backend
# El venv del backend debe estar en <WorkingDirectory>/env.

[Unit]
Description=FundaPineda backend (uvicorn + FastAPI)
Documentation=https://github.com/anomalyco/opencode
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple

User=fundapineda
Group=fundapineda

WorkingDirectory=/opt/fundapineda/Api-FundaPineda
EnvironmentFile=/opt/fundapineda/.env

# Solo escucha en localhost: nginx es el unico que entra
ExecStart=/opt/fundapineda/Api-FundaPineda/env/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --workers 1 --no-access-log
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5

# Hardening basico
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65535

# El backend escribe adscripciones, firmas, noticias y temporalmente aqui
ReadWritePaths=/opt/fundapineda/Api-FundaPineda/src/static

[Install]
WantedBy=multi-user.target